        ind.classList.remove('bg-emerald-400');
        ind.classList.add('bg-white');
        autoTourTimer = setInterval(() => nextRoom(), 4500);
      } else {
        btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-400');
        btn.classList.add('bg-[#131b2e]', 'text-emerald-400');
        ind.classList.add('bg-emerald-400');
