        camLerpTarget = new THREE.Vector3(found.cam.pos.x, found.cam.pos.y, found.cam.pos.z);
        ctrlLerpTarget = new THREE.Vector3(found.cam.target.x, found.cam.target.y, found.cam.target.z);
      }
    }

