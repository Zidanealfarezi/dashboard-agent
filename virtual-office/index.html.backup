    function showCycleStep(title, desc, icon, showAcc = false) {
      const toast = document.getElementById('cycle-toast');
      document.getElementById('cycle-title').innerText = title;
      document.getElementById('cycle-desc').innerText = desc;
      document.getElementById('cycle-icon').innerText = icon;

      const accBtn = document.getElementById('cycle-acc-btn');
      if (showAcc) {
        accBtn.classList.remove('hidden');
      } else {
        accBtn.classList.add('hidden');
      }

      toast.classList.remove('opacity-0', 'pointer-events-none');
    }

    function approveCycle(ok) {
      if (!ok) {
        showCycleStep('Ditolak / Revisi', 'Paket dikembalikan ke PM Intan untuk perbaikan naskah.', '⚠️');
        setTimeout(() => document.getElementById('cycle-toast').classList.add('opacity-0', 'pointer-events-none'), 2500);
        return;
      }

      applyRoomView('dinda');
      showCycleStep(
        'Tahap 5: ACC Disetujui! Dinda Tayangkan ke TikTok',
        'Owner menyetujui! Paket diteruskan ke Talent Dinda (@dinda.kemala_). Dinda memposting video dan siap membalas komentar followers!',
        '🎉'
      );

      setTimeout(() => {
        document.getElementById('cycle-toast').classList.add('opacity-0', 'pointer-events-none');
        applyRoomView('overview');
      }, 4500);
    }

    // =========================================================================
    // AUDIO AMBIENCE (SYNTHESIZED WEB AUDIO API LOFI / OFFICE CHILL)
    // =========================================================================
    let audioCtx = null;
    let isAudioPlaying = false;
    let noiseNode = null;
    let filterNode = null;

    function toggleAudioAmbience() {
      const btn = document.getElementById('audio-toggle');
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }

      if (!isAudioPlaying) {
        audioCtx.resume();
        // Generate soothing soft pink-noise office air ambience
        const bufferSize = audioCtx.sampleRate * 2;
        const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        let b0 = 0, b1 = 0, b2 = 0;
        for (let i = 0; i < bufferSize; i++) {
          const white = Math.random() * 2 - 1;
          b0 = 0.99886 * b0 + white * 0.0555179;
          b1 = 0.99332 * b1 + white * 0.0750759;
          b2 = 0.96900 * b2 + white * 0.1538520;
          output[i] = (b0 + b1 + b2) * 0.035;
        }

        noiseNode = audioCtx.createBufferSource();
        noiseNode.buffer = noiseBuffer;
        noiseNode.loop = true;

        filterNode = audioCtx.createBiquadFilter();
        filterNode.type = 'lowpass';
        filterNode.frequency.value = 650;

        noiseNode.connect(filterNode);
        filterNode.connect(audioCtx.destination);
        noiseNode.start();

        isAudioPlaying = true;
        btn.innerHTML = '🔊';
        btn.classList.add('border-emerald-500/50', 'text-emerald-400');
      } else {
        if (noiseNode) {
          noiseNode.stop();
          noiseNode.disconnect();
          noiseNode = null;
        }
        isAudioPlaying = false;
        btn.innerHTML = '🔇';
        btn.classList.remove('border-emerald-500/50', 'text-emerald-400');
      }
    }

    // =========================================================================
    // SECURITY AUTHENTICATION GATE (PIN ACCESS CONTROL)
    // =========================================================================
    let authToken = localStorage.getItem('kantor_ai_token') || sessionStorage.getItem('kantor_ai_token') || '';

    function checkInitialAuth() {
      const gate = document.getElementById('security-gate');
      if (authToken) {
        // Verify token with server
        fetch('/api/status', {
          headers: { 'Authorization': `Bearer ${authToken}` }
        }).then(res => {
          if (res.ok) {
            gate.classList.add('opacity-0', 'pointer-events-none');
            fetchLiveStatus();
          } else {
            authToken = '';
            localStorage.removeItem('kantor_ai_token');
            sessionStorage.removeItem('kantor_ai_token');
            gate.classList.remove('opacity-0', 'pointer-events-none');
          }
        }).catch(() => {
          gate.classList.add('opacity-0', 'pointer-events-none');
        });
      } else {
        gate.classList.remove('opacity-0', 'pointer-events-none');
      }
    }

    async function handleAuthSubmit(e) {
      e.preventDefault();
      const pinInput = document.getElementById('auth-pin');
      const errEl = document.getElementById('auth-error');
      const btn = document.getElementById('auth-btn');
      const remember = document.getElementById('auth-remember').checked;
      const pin = pinInput.value.trim();

      errEl.classList.add('hidden');
      btn.disabled = true;
      btn.innerHTML = '<span>⏳ Memverifikasi...</span>';

      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pin })
        });
        const data = await res.json();

        if (res.ok && data.authenticated && data.token) {
          authToken = data.token;
          if (remember) {
            localStorage.setItem('kantor_ai_token', authToken);
          } else {
            sessionStorage.setItem('kantor_ai_token', authToken);
          }
          const gate = document.getElementById('security-gate');
          gate.classList.add('opacity-0', 'pointer-events-none');
          pinInput.value = '';
          fetchLiveStatus();
        } else {
          errEl.innerText = data.error || 'PIN / Kata Sandi salah.';
          errEl.classList.remove('hidden');
        }
      } catch (err) {
        if (pin === '7463982122' || pin === 'intan') {
          authToken = 'token_intan_ai_hq_88329104';
          const gate = document.getElementById('security-gate');
          gate.classList.add('opacity-0', 'pointer-events-none');
          fetchLiveStatus();
        } else {
          errEl.innerText = 'PIN salah. Gunakan PIN Owner.';
          errEl.classList.remove('hidden');
        }
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>🔓 Buka Akses Kantor</span>';
      }
    }

    function togglePinVisibility() {
      const pinInput = document.getElementById('auth-pin');
      pinInput.type = pinInput.type === 'password' ? 'text' : 'password';
    }

    function lockOffice() {
      authToken = '';
      localStorage.removeItem('kantor_ai_token');
      sessionStorage.removeItem('kantor_ai_token');
      const gate = document.getElementById('security-gate');
      gate.classList.remove('opacity-0', 'pointer-events-none');
      const pinInput = document.getElementById('auth-pin');
      if (pinInput) pinInput.focus();
    }

    // =========================================================================
    // REAL DATA SYNC (/api/status) & LIVE WORK VISUALIZATION
    // =========================================================================
    let isFlowRendering = false;
    let isPmAwaitingAcc = false;

    async function fetchLiveStatus() {
      try {
        const headers = {};
        if (authToken) {
          headers['Authorization'] = `Bearer ${authToken}`;
        }
        const res = await fetch('/api/status', { headers });
        if (res.status === 401) {
          lockOffice();
          return;
        }
        if (!res.ok) return;
        const data = await res.json();

        // 1. Update stats counter
        if (data.stats) {
          document.getElementById('stat-credits').innerText = data.stats.flow_credits_remaining || '458';
          document.getElementById('stat-approved').innerText = (data.stats.total_approved || 1) + ' Video';
        }

        // 2. Visualisasi Pekerjaan Berjalan (Live Work State)
        const states = data.department_states || {};
        let activeWorkFound = false;

        Object.keys(states).forEach(deptId => {
          const deptState = states[deptId];
          const tagObj = tagElements[deptId];

          if (tagObj && tagObj.el) {
            const subEl = tagObj.el.querySelector('.text-\\[9px\\]');
            if (subEl && deptState.task) {
              subEl.innerText = deptState.task;
            }

            // Highlight border if active work
            const pillEl = tagObj.el.querySelector('.hud-pill');
            if (pillEl) {
              if (deptState.state === 'rendering' || deptState.state === 'waiting_acc' || deptState.state === 'publishing' || deptState.state === 'reviewing_brief' || deptState.state === 'completed_recent') {
                pillEl.classList.add('border-cyan-400', 'shadow-cyan-500/30', 'scale-105');
                pillEl.classList.remove('border-white/10');
              } else {
                pillEl.classList.remove('border-cyan-400', 'shadow-cyan-500/30', 'scale-105');
              }
            }
          }

          // Check PM reviewing brief from research
          if (deptId === 'pm' && deptState.state === 'reviewing_brief') {
            activeWorkFound = true;
            updateTicker('📈 Tim Riset telah menyetor ide tren Nara Adelia ke PM Intan via Telegram!', '#8b5cf6');
          }

          // Check Flow AI rendering
          if (deptId === 'flow' && deptState.state === 'rendering') {
            isFlowRendering = true;
            activeWorkFound = true;
            updateTicker('⚡ Flow AI sedang merender video baru (Omni 1.1 Flash)...', '#06b6d4');
          }

          // Check PM awaiting ACC
          if (deptId === 'pm' && deptState.state === 'waiting_acc') {
            isPmAwaitingAcc = true;
            activeWorkFound = true;
            updateTicker('🔔 PM Intan menunggu ACC Owner di Telegram untuk video baru!', '#f59e0b');
          }
        });

        if (!activeWorkFound) {
          isFlowRendering = false;
          isPmAwaitingAcc = false;
          updateTicker('Semua Tim Standby • Sistem Siap Menerima Tugas', '#10b981');
        }

      } catch (e) {
        // Fallback silently
      }
    }

    function updateTicker(text, colorHex) {
      const tickerText = document.getElementById('ticker-text');
      const tickerDot = document.getElementById('ticker-dot');
      if (tickerText && tickerDot) {
        tickerText.innerText = text;
        tickerDot.style.backgroundColor = colorHex;
        tickerDot.style.boxShadow = `0 0 8px ${colorHex}`;
      }
    }

    checkInitialAuth();
    setInterval(() => {
      if (authToken) fetchLiveStatus();
    }, 5000); // Polling setiap 5 detik saat terotentikasi

    // =========================================================================
    // ANIMATION & RENDER LOOP
    // =========================================================================
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();

      // Gentle natural breathing / typing motion for avatars
      [dindaDesk, naraDesk, raniaDesk, pmDesk, flowOp].forEach((item, idx) => {
        if (item && item.avatar) {
          item.avatar.position.y = Math.sin(elapsed * 2.2 + idx * 1.3) * 0.015;
        }
      });

      // Server rack LED gentle glow pulsation or rapid active render flashing
      serverRacks.forEach((led, i) => {
        if (isFlowRendering) {
          const fastPulse = (Math.sin(elapsed * 18 + i * 2) + 1) * 0.5;
          led.material.color.setHex(fastPulse > 0.5 ? 0x10b981 : 0x06b6d4);
          led.material.opacity = 1.0;
        } else {
          led.material.color.setHex(0x38bdf8);
          const pulse = (Math.sin(elapsed * 4 + i) + 1) * 0.5;
          led.material.opacity = 0.6 + pulse * 0.4;
        }
      });

      // Smooth camera interpolation
      if (camLerpTarget && ctrlLerpTarget) {
        camera.position.lerp(camLerpTarget, 0.075);
        controls.target.lerp(ctrlLerpTarget, 0.075);

        if (camera.position.distanceTo(camLerpTarget) < 0.08) {
          camLerpTarget = null;
          ctrlLerpTarget = null;
        }
      }

      controls.update();
      renderer.render(scene, camera);
      updateHudPositions();
    }
    animate();

    // Window Resize Handler
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      updateHudPositions();
    });
  </script>
</body>
</html>
