      document.getElementById('current-room-label').innerText = roomNames[key] || 'Seluruh Kantor';

      if (key === 'overview') {
        camLerpTarget = new THREE.Vector3(0, 19, 40);
        ctrlLerpTarget = new THREE.Vector3(0, 5, 0);
