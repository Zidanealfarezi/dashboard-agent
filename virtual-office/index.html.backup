    let currentActionUrl = '#';

    function inspectDepartment(key) {
      const data = deptInfo[key];
      if (!data) return;

      document.getElementById('insp-tag').innerText = 'DIVISI';
      document.getElementById('insp-title').innerText = data.title;
      document.getElementById('insp-subtitle').innerText = data.sub;
      document.getElementById('insp-m1').innerText = data.m1;
      document.getElementById('insp-m2').innerText = data.m2;
      document.getElementById('insp-status').innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> ${data.status}`;
      document.getElementById('insp-status-desc').innerText = data.desc;

      const rulesEl = document.getElementById('insp-rules');
      rulesEl.innerHTML = data.rules.map(r => `<li>${r}</li>`).join('');

      const logsEl = document.getElementById('insp-logs');
      logsEl.innerHTML = data.logs.map(l => `
        <div class="p-2.5 rounded-xl bg-black/40 border border-white/5 text-neutral-300">
          ${l}
        </div>
      `).join('');

      document.getElementById('insp-action-text').innerText = data.actionText;
      currentActionUrl = data.actionUrl;

      document.getElementById('inspector-drawer').classList.remove('translate-x-[115%]');
      applyRoomView(key);
    }

    function closeInspector() {
      document.getElementById('inspector-drawer').classList.add('translate-x-[115%]');
    }

    function executeInspectorAction() {
      if (currentActionUrl.startsWith('http')) {
        window.open(currentActionUrl, '_blank');
      } else if (currentActionUrl.startsWith('javascript:')) {
        eval(currentActionUrl.replace('javascript:', ''));
      } else {
        alert('Aksi divisi dijalankan.');
      }
    }

    async function triggerWeeklyEvaluation() {
      const btnText = document.getElementById('insp-action-text');
      if (btnText) btnText.innerText = 'Mengirim Scorecard...';
      try {
        const res = await fetch('/api/trigger-evaluation', { method: 'POST' });
        const data = await res.json();
        if (data.ok) {
          alert('✓ Laporan Evaluasi Mingguan sukses dikirim ke Telegram (@PM_INTAN_BOT)!');
        } else {
          alert('Gagal: ' + (data.error || 'Terjadi kendala'));
        }
      } catch (e) {
        alert('Laporan berhasil diproses.');
      } finally {
        if (btnText) btnText.innerText = 'Kirim Ulang Scorecard ke Telegram';
      }
    }

