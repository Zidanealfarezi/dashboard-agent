(() => {
  'use strict';
  let instance;
  const layout = [
    {id:'pm',floor:1,x:-7.4,z:-7.6,w:13.8,d:8.1,label:'RUANG PRODUKSI',accent:0xb29d82},
    {id:'researcher',floor:1,x:7.4,z:-7.6,w:13.8,d:8.1,label:'RISET',accent:0x82918e},
    {id:'sales',floor:1,x:-7.4,z:7.0,w:13.8,d:7.8,label:'PENJUALAN',accent:0xa5735d},
    {id:'default',floor:1,x:7.4,z:7.0,w:13.8,d:7.8,label:'OPERASIONAL',accent:0x7d8880},
    {id:'dinda',floor:2,x:-9.6,z:-6.5,w:9.1,d:9.2,label:'STUDIO DINDA',accent:0xa77968},
    {id:'nara',floor:2,x:0,z:-6.5,w:9.1,d:9.2,label:'STUDIO NARA',accent:0x879583},
    {id:'rania',floor:2,x:9.6,z:-6.5,w:9.1,d:9.2,label:'STUDIO RANIA',accent:0x8a909c}
  ];
  const floorNames={1:'Lantai 1 · Operasional',2:'Lantai 2 · Studio talent'};
  function createOffice(container) {
    const T=window.THREE;
    if(!T || !T.OrbitControls) throw new Error('local_3d_assets_unavailable');
    const scene=new T.Scene();
    const camera=new T.OrthographicCamera(-24,24,20,-20,.1,250);
    const isometricPosition=new T.Vector3(29,38,45);
    camera.position.copy(isometricPosition);
    const renderer=new T.WebGLRenderer({antialias:true,alpha:false,powerPreference:'low-power'});
    renderer.setPixelRatio(Math.min(devicePixelRatio,1.6));
    renderer.outputEncoding=T.sRGBEncoding;
    renderer.toneMapping=T.ACESFilmicToneMapping;
    renderer.toneMappingExposure=.86;
    renderer.shadowMap.enabled=true;
    renderer.shadowMap.type=T.PCFSoftShadowMap;
    renderer.domElement.setAttribute('aria-label','Kantor tiga dimensi. Geser untuk memutar dan gunakan tombol ruang untuk memilih agen.');
    renderer.domElement.setAttribute('role','img');
    container.prepend(renderer.domElement);
    const controls=new T.OrbitControls(camera,renderer.domElement);
    controls.enableDamping=true;
    controls.dampingFactor=.09;
    controls.enablePan=true;
    controls.minPolarAngle=.18;
    controls.maxPolarAngle=Math.PI*.46;
    controls.minZoom=.7;
    controls.maxZoom=4.5;
    controls.target.set(0,.4,0);
    controls.screenSpacePanning=true;
    controls.rotateSpeed=.6;
    controls.zoomSpeed=.8;
    const office=new T.Group();scene.add(office);
    const levels={1:new T.Group(),2:new T.Group()};
    office.add(levels[1],levels[2]);levels[2].visible=false;
    let dirty=true,tween=null,selected='sales',agents=[],visible=true,activeFloor=1,topView=false;
    const rooms=new Map();
    const raycaster=new T.Raycaster(),pointer=new T.Vector2();
    const hitMeshes={1:[],2:[]};
    const tooltip=container.querySelector('.scene-tooltip');
    const labels=container.querySelector('.scene-labels');
    const frameElement=container.closest('.scene-frame');
    const floorButtons=[...frameElement.querySelectorAll('[data-office-floor]')];
    const viewButtons=[...frameElement.querySelectorAll('[data-office-view]')];
    const projected=new T.Vector3();
    const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');
    const clock=new T.Clock();
    const materials={};
    const mat=(key,color,options={})=>{if(materials[key])return materials[key];const material=new T.MeshStandardMaterial({color,roughness:.8,...options});material.color.convertSRGBToLinear();materials[key]=material;return material;};
    const plaster=mat('plaster',0xe8e5dc),oak=mat('oak',0xbca27d),oakDark=mat('oakDark',0x796c54),linen=mat('linen',0xe0dfd0),sage=mat('sage',0x69775d),metal=mat('metal',0x3f4940,{roughness:.48}),paper=mat('paper',0xf5f1e5),skin=mat('skin',0xc5b49a);
    function box(parent,w,h,d,x,y,z,material,shadow=true) {
      const mesh=new T.Mesh(new T.BoxGeometry(w,h,d),material);
      mesh.position.set(x,y,z);mesh.castShadow=shadow;mesh.receiveShadow=true;parent.add(mesh);return mesh;
    }
    function cylinder(parent,r1,r2,h,x,y,z,material,segments=12) {
      const mesh=new T.Mesh(new T.CylinderGeometry(r1,r2,h,segments),material);
      mesh.position.set(x,y,z);mesh.castShadow=true;mesh.receiveShadow=true;parent.add(mesh);return mesh;
    }
    function sphere(parent,r,x,y,z,material,sx=1,sy=1,sz=1) {
      const mesh=new T.Mesh(new T.SphereGeometry(r,12,10),material);mesh.position.set(x,y,z);mesh.scale.set(sx,sy,sz);mesh.castShadow=true;parent.add(mesh);return mesh;
    }
    function floorTexture() {
      const canvas=document.createElement('canvas');canvas.width=512;canvas.height=512;
      const ctx=canvas.getContext('2d');
      ctx.fillStyle='#d1c2a5';ctx.fillRect(0,0,512,512);
      for(let row=0;row<16;row++){
        ctx.fillStyle=row%3===0?'#cabc9e':row%3===1?'#d5c7ab':'#d0c1a3';ctx.fillRect(0,row*32,512,31);
        ctx.fillStyle='rgba(105,87,56,.12)';ctx.fillRect(0,row*32+31,512,1);
        ctx.fillRect((row%2)*256+100,row*32,1,32);
        for(let n=0;n<3;n++){ctx.fillStyle='rgba(255,249,226,.13)';ctx.fillRect((row*37+n*89)%410,row*32+7+n*5,80,1);}
      }
      const texture=new T.CanvasTexture(canvas);texture.wrapS=texture.wrapT=T.RepeatWrapping;texture.repeat.set(3,3);texture.encoding=T.sRGBEncoding;return texture;
    }
    function sign(parent,text,w,x,z) {
      const canvas=document.createElement('canvas');canvas.width=640;canvas.height=136;
      const ctx=canvas.getContext('2d');ctx.fillStyle='#f4f0e6';ctx.fillRect(0,0,640,136);ctx.fillStyle='#314239';ctx.font='700 50px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,320,68);
      const texture=new T.CanvasTexture(canvas);texture.encoding=T.sRGBEncoding;
      const mesh=new T.Mesh(new T.PlaneGeometry(w,.53),new T.MeshBasicMaterial({map:texture,side:T.DoubleSide}));
      mesh.position.set(x,1.24,z);parent.add(mesh);return mesh;
    }
    function plant(parent,x,z,scale=1) {
      const g=new T.Group();g.position.set(x,.1,z);g.scale.setScalar(scale);parent.add(g);
      cylinder(g,.38,.28,.65,0,.32,0,mat('pot',0xb7a88e));
      cylinder(g,.34,.34,.035,0,.66,0,oakDark);
      cylinder(g,.035,.035,1.05,0,1.12,0,sage,6);
      for(let i=0;i<5;i++){const angle=i*2.4;const leaf=sphere(g,.45,Math.sin(angle)*.25,1.13+i*.12,Math.cos(angle)*.25,sage,.7,1.3,.38);leaf.rotation.z=Math.sin(angle)*.7;leaf.rotation.y=angle;}
    }
    function chair(parent,x,z) {
      const g=new T.Group();g.position.set(x,0,z);parent.add(g);
      box(g,1,.13,1,0,.88,0,sage);
      box(g,1,.85,.16,0,1.32,.46,sage);
      cylinder(g,.07,.07,.7,0,.44,0,metal,8);
      box(g,1,.06,.07,0,.13,0,metal);box(g,.07,.06,1,0,.13,0,metal);
    }
    function person(parent,x,z,color) {
      const g=new T.Group();g.position.set(x,0,z);parent.add(g);
      const jacket=mat('jacket'+color,color);
      cylinder(g,.28,.35,.7,0,1.3,0,jacket);
      sphere(g,.28,0,1.93,0,skin,1,1.1,1);
      sphere(g,.26,0,2.07,.04,oakDark,1,.68,1);
      box(g,.2,.2,.62,-.21,.91,-.23,metal);box(g,.2,.2,.62,.21,.91,-.23,metal);
      box(g,.16,.59,.16,-.23,.64,-.51,metal);box(g,.16,.59,.16,.23,.64,-.51,metal);
      const left=box(g,.15,.56,.15,-.4,1.25,-.14,jacket);left.rotation.x=-.45;
      const right=box(g,.15,.56,.15,.4,1.25,-.14,jacket);right.rotation.x=-.45;
    }
    function workstation(parent,x,z,staffColor=null) {
      const g=new T.Group();g.position.set(x,0,z);parent.add(g);
      box(g,3.5,.16,1.65,0,1.5,0,oak);
      for(const dx of [-1.45,1.45])for(const dz of [-.55,.55])box(g,.085,1.4,.085,dx,.75,dz,metal);
      box(g,1.12,.7,.08,0,2.1,-.35,metal);
      box(g,1.01,.57,.025,0,2.1,-.297,mat('screen',0x8c9e94,{roughness:.45}));
      box(g,.08,.3,.07,0,1.72,-.35,metal);box(g,.5,.035,.35,0,1.61,-.35,metal);
      box(g,.72,.035,.24,-.05,1.61,.35,mat('keyboard',0xd3d5c9));
      box(g,.45,.04,.65,.98,1.63,.14,paper);
      cylinder(g,.1,.08,.22,-1.05,1.73,.18,paper);
      chair(g,0,1.2);
      if(staffColor!==null)person(g,0,1.07,staffColor);
      return g;
    }
    scene.add(new T.HemisphereLight(0xfff8e6,0x7c8779,.7));
    const sun=new T.DirectionalLight(0xfff1d5,1.05);sun.position.set(-16,29,14);sun.castShadow=true;
    sun.shadow.mapSize.set(2048,2048);Object.assign(sun.shadow.camera,{left:-24,right:24,top:24,bottom:-24,near:1,far:85});
    sun.shadow.normalBias=.035;sun.shadow.bias=-.0002;sun.shadow.radius=3;scene.add(sun);
    const fill=new T.DirectionalLight(0xe3ebef,.3);fill.position.set(20,16,-10);scene.add(fill);
    const canvasColor=0xdfdbcd;
    scene.background=new T.Color(canvasColor).convertSRGBToLinear();
    box(scene,150,.1,150,0,-.8,0,new T.MeshBasicMaterial({color:scene.background}),false);
    const grid=new T.GridHelper(150,75,0xb9b4a4,0xc6c0b0);
    grid.position.y=-.74;
    grid.material.transparent=true;grid.material.opacity=.42;
    scene.add(grid);
    box(office,31,.62,25,0,-.29,0,oakDark);
    box(office,30.8,.14,24.8,0,0,0,new T.MeshStandardMaterial({map:floorTexture(),roughness:.88}));

    const glass=mat('glass',0xc9dfdf,{transparent:true,opacity:.3,roughness:.25,metalness:.05,depthWrite:false});
    const corridor=mat('corridor',0xcdcbc1);
    const upholstery=mat('upholstery',0xac725d);
    const windowFrame=mat('window-frame',0x788982);
    box(office,31,1.65,.2,0,.85,-12.35,plaster);
    box(office,.22,1.12,24.7,-15.35,.62,0,plaster);
    box(office,.22,.36,24.7,15.35,.23,0,plaster);
    for(const z of [-9,-3,3,9]) {
      box(office,4.6,.85,.055,z,1.98,-12.35,glass,false);
      box(office,4.85,.08,.13,z,2.4,-12.33,windowFrame,false);
      for(const x of [z-2.4,z+2.4])box(office,.08,.85,.13,x,1.98,-12.33,windowFrame,false);
    }
    function partition(parent,x,width,z) {
      box(parent,width,.28,.14,x,.2,z,plaster);
      box(parent,width,.85,.065,x,.77,z,glass,false);
      box(parent,width,.07,.09,x,1.22,z,windowFrame,false);
      for(const end of [-1,1])box(parent,.07,1,.09,x+end*width/2,.76,z,windowFrame,false);
    }
    function sofa(parent,x,z,color) {
      box(parent,3.2,.52,1.12,x,.36,z,color);
      box(parent,3.2,.58,.19,x,.81,z-.47,color);
      for(const offset of [-1.52,1.52])box(parent,.17,.63,1.12,x+offset,.65,z,color);
    }
    box(levels[1],30.1,.025,5.4,0,.087,-.35,corridor,false);
    box(levels[2],30.1,.025,4.9,0,.087,.95,corridor,false);
    for(const data of layout){
      const group=new T.Group();group.position.set(data.x,0,data.z);group.userData.agentId=data.id;
      levels[data.floor].add(group);
      const rugMaterial=new T.MeshStandardMaterial({color:0xdbdbcb,roughness:1});rugMaterial.color.convertSRGBToLinear();
      box(group,data.w,.027,data.d,0,.09,0,rugMaterial,false);
      box(group,data.w,1.65,.17,0,.91,-data.d/2,plaster);
      box(group,.17,1.12,data.d-.1,-data.w/2,.64,0,plaster);
      box(group,.17,.86,data.d-.1,data.w/2,.51,0,plaster);
      sign(group,data.label,Math.min(data.w-1,5.7),0,-data.d/2+.099);
      for(const direction of [-1,1]){
        const width=(data.w-2.7)/2;
        partition(group,direction*(data.w/2-width/2),width,data.d/2);
      }
      const deskX=data.w>10?-1.5:0;
      workstation(group,deskX,-.8,data.accent);
      if(data.id==='default'){
        for(let i=0;i<2;i++){
          const x=2.35+i*1.7;
          box(group,1.15,2.24,1.06,x,1.25,-2,metal);
          for(let n=0;n<6;n++){
            box(group,.96,.17,.035,x,.46+n*.29,-1.45,mat('rackface',0x657162));
            box(group,.075,.055,.045,x+.34,.46+n*.29,-1.42,linen,false);
          }
        }
      }else if(data.w>10){
        sofa(group,3.8,-1.45,data.id==='sales'?upholstery:linen);
        cylinder(group,.62,.62,.56,3.8,.35,.42,oak);
      }
      plant(group,data.w/2-1.08,-data.d/2+.95,.64);
      const marker=cylinder(group,.14,.14,.08,deskX+.85,1.66,-.5,sage,10);
      const label=document.createElement('button');
      label.type='button';label.className='scene-agent';label.hidden=true;
      const dot=document.createElement('span');dot.className='scene-agent-dot';dot.setAttribute('aria-hidden','true');
      const name=document.createElement('span');label.append(dot,name);labels.append(label);
      label.addEventListener('click',()=>selectFromScene(data.id));
      group.traverse(object=>{if(object.isMesh)hitMeshes[data.floor].push(object);});
      rooms.set(data.id,{group,rugMaterial,marker,data,label,name,
        anchor:new T.Vector3(data.x+deskX,2.77,data.z+.39)});
    }
    plant(office,-14.3,-.55,.88);plant(office,14.3,-.55,.88);
    // A shared production corridor and a breakout area on the talent floor.
    for(const x of [-11,11]) {
      box(levels[1],2.35,.44,.88,x,.3,-.35,linen);
      cylinder(levels[1],.38,.38,.58,x+1.95,.34,-.35,oak);
    }
    box(levels[2],22,.025,7.6,0,.085,7.4,mat('lounge-rug',0xbab7a5),false);
    sofa(levels[2],-7.8,7.4,upholstery);
    sofa(levels[2],-3.7,7.4,linen);
    cylinder(levels[2],.85,.85,.58,-5.75,.34,9.3,oak);
    box(levels[2],5.3,.14,2.1,5.6,1.33,7.2,oak);
    for(const x of [3.55,7.65])for(const z of [6.52,7.88])box(levels[2],.13,1.2,.13,x,.69,z,metal);
    for(const x of [3.9,5.6,7.3])chair(levels[2],x,8.95);
    plant(levels[2],10.7,9.55,.85);plant(levels[2],-10.7,9.55,.85);
    function resize(){
      const w=container.clientWidth,h=container.clientHeight;if(!w||!h)return;
      const aspect=w/h,span=Math.max(topView?28:27,43/aspect);
      camera.left=-span*aspect/2;camera.right=span*aspect/2;camera.top=span/2;camera.bottom=-span/2;
      camera.updateProjectionMatrix();renderer.setSize(w,h,false);dirty=true;
    }
    new ResizeObserver(resize).observe(container);resize();
    function moveCamera(target,position,zoom,animate=true){
      if(animate&&!reducedMotion.matches){
        tween={start:performance.now(),from:controls.target.clone(),to:target,
          position:camera.position.clone(),endPosition:position,fromZoom:camera.zoom,toZoom:zoom};
      }else{
        tween=null;controls.target.copy(target);camera.position.copy(position);camera.zoom=zoom;
        camera.updateProjectionMatrix();controls.update();dirty=true;
      }
    }
    function focus(id,zoom=true){
      const room=rooms.get(id);if(!room)return;
      selected=id;
      rooms.forEach((r,key)=>{
        r.rugMaterial.color.setHex(key===id?0xc4b397:0xdbdbcb).convertSRGBToLinear();
        r.label.setAttribute('aria-pressed',String(key===id));
      });
      if(zoom){
        const switched=room.data.floor!==activeFloor;
        if(switched)setFloor(room.data.floor,false);
        const target=new T.Vector3(room.data.x,.5,room.data.z);
        const offset=camera.position.clone().sub(controls.target);
        moveCamera(target,target.clone().add(offset),2.05,!switched);
      }
      dirty=true;
    }
    function home(animate=true){
      const position=topView?new T.Vector3(0,57,1):isometricPosition.clone();
      moveCamera(new T.Vector3(0,.4,0),position,1,animate);
      container.dispatchEvent(new CustomEvent('office:view-change',{bubbles:true,detail:{label:floorNames[activeFloor]}}));
    }
    function selectFromScene(id,zoom=true){
      focus(id,zoom);
      container.dispatchEvent(new CustomEvent('office:select-agent',{bubbles:true,detail:{id}}));
    }
    function setFloor(next,choose=true){
      if(next===activeFloor)return;
      levels[activeFloor].visible=false;activeFloor=next;levels[activeFloor].visible=true;
      tooltip.hidden=true;
      floorButtons.forEach(button=>button.setAttribute('aria-pressed',String(Number(button.dataset.officeFloor)===activeFloor)));
      if(choose){
        const first=layout.find(room=>room.floor===activeFloor&&agents.some(agent=>agent.id===room.id));
        if(first)selectFromScene(first.id,false);
      }
      home(false);
    }
    floorButtons.forEach(button=>button.addEventListener('click',()=>setFloor(Number(button.dataset.officeFloor))));
    viewButtons.forEach(button=>button.addEventListener('click',()=>{
      const next=button.dataset.officeView==='top';
      if(topView===next)return;
      topView=next;controls.enableRotate=!topView;
      controls.minPolarAngle=topView ? .001 : .18;
      controls.maxPolarAngle=topView ? .025 : Math.PI*.46;
      viewButtons.forEach(control=>control.setAttribute('aria-pressed',String(control===button)));
      resize();home(false);
    }));
    function zoomBy(amount){tween=null;camera.zoom=Math.max(.7,Math.min(4.5,camera.zoom*amount));camera.updateProjectionMatrix();dirty=true;}
    function pick(event){
      const rect=renderer.domElement.getBoundingClientRect();
      pointer.set((event.clientX-rect.left)/rect.width*2-1,-(event.clientY-rect.top)/rect.height*2+1);
      raycaster.setFromCamera(pointer,camera);
      const hits=raycaster.intersectObjects(hitMeshes[activeFloor],false);
      if(!hits.length)return null;
      let object=hits[0].object;while(object&&!object.userData.agentId)object=object.parent;
      return object?.userData.agentId || null;
    }
    let down=null,lastHover=0;
    renderer.domElement.addEventListener('pointerdown',e=>{down={x:e.clientX,y:e.clientY};tween=null;tooltip.hidden=true;});
    renderer.domElement.addEventListener('pointerup',e=>{
      if(!down || Math.hypot(e.clientX-down.x,e.clientY-down.y)>7){down=null;return;}
      down=null;const id=pick(e);if(id)selectFromScene(id);
    });
    renderer.domElement.addEventListener('pointermove',e=>{
      if(e.buttons || e.pointerType==='touch' || performance.now()-lastHover<55)return;
      lastHover=performance.now();const id=pick(e);const agent=agents.find(a=>a.id===id);
      tooltip.hidden=!agent;renderer.domElement.style.cursor=agent?'pointer':'grab';
      if(agent){const r=container.getBoundingClientRect();tooltip.textContent=agent.short_name;tooltip.style.left=Math.max(10,Math.min(r.width-125,e.clientX-r.left+12))+'px';tooltip.style.top=Math.max(10,e.clientY-r.top-32)+'px';}
    });
    renderer.domElement.addEventListener('pointerleave',()=>tooltip.hidden=true);
    controls.addEventListener('change',()=>dirty=true);
    renderer.domElement.addEventListener('webglcontextlost',event=>{event.preventDefault();container.querySelector('.scene-loading').hidden=false;container.querySelector('.scene-loading').textContent='Tampilan 3D terhenti. Muat ulang kantor untuk melanjutkan.';});
    function positionLabels(){
      const width=container.clientWidth,height=container.clientHeight;
      rooms.forEach(room=>{
        projected.copy(room.anchor).project(camera);
        const outside=Math.abs(projected.x)>.92||Math.abs(projected.y)>.89;
        room.label.hidden=room.data.floor!==activeFloor||!room.name.textContent||outside;
        if(!room.label.hidden){
          room.label.style.left=(projected.x*.5+.5)*width+'px';
          room.label.style.top=(-projected.y*.5+.5)*height+'px';
        }
      });
    }
    function frame(time){
      requestAnimationFrame(frame);
      if(!visible || document.hidden || !container.clientWidth)return;
      if(tween){
        const t=Math.min(1,(time-tween.start)/700),ease=1-Math.pow(1-t,3);
        controls.target.lerpVectors(tween.from,tween.to,ease);camera.position.lerpVectors(tween.position,tween.endPosition,ease);
        camera.zoom=tween.fromZoom+(tween.toZoom-tween.fromZoom)*ease;camera.updateProjectionMatrix();dirty=true;if(t===1)tween=null;
      }
      controls.update(clock.getDelta());
      if(dirty){renderer.render(scene,camera);positionLabels();dirty=false;}
    }
    requestAnimationFrame(frame);
    container.querySelector('.scene-loading').hidden=true;
    focus(selected,false);
    return {update(next){
      agents=next;
      rooms.forEach((room,id)=>{
        const agent=agents.find(a=>a.id===id);
        const runtime=agent?.runtime||'unknown';
        room.name.textContent=agent?.short_name||'';
        room.label.dataset.runtime=runtime;
        room.label.setAttribute('aria-label',agent?('Meja '+agent.short_name+' · '+agent.runtime_label):'Meja agen');
        room.marker.material=runtime==='available'?sage:runtime==='paused'?mat('paused',0x9f825d):mat('unconfirmed',0x8d9192);
      });
      dirty=true;
    },select:focus,home,zoom:zoomBy,setVisible(value){visible=value;dirty=true;if(value)resize();}};
  }
  window.Office3D={
    update(agents){
      const container=document.getElementById('office-viewport');if(!container)return;
      try{instance=instance||createOffice(container);instance.update(agents);}catch(error){const text=container.querySelector('.scene-loading');text.hidden=false;text.textContent='Tampilan 3D belum dapat dimuat. Periksa dukungan grafis browser, lalu muat ulang.';container.dataset.error='true';console.error('Office 3D initialization failed:',error.message);}
    },
    select(id,zoom=true){instance?.select(id,zoom);},home(){instance?.home();},zoom(amount){instance?.zoom(amount);},setVisible(value){instance?.setVisible(value);}
  };
})();
